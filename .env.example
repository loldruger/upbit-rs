# Upbit API 설정 예시 파일
# 이 파일을 .env로 복사하고 실제 값으로 수정하세요

# 프로덕션 환경에서 사용할 Upbit API 키
# https://upbit.com/mypage/open_api_management 에서 발급받으세요
UPBIT_ACCESS_KEY="your_access_key_here"
UPBIT_SECRET_KEY="your_secret_key_here"

# 테스트 환경에서 사용할 API 키
# 테스트용 계정이나 모의 거래용 키를 사용하세요
TEST_ACCESS_KEY="your_test_access_key_here"
TEST_SECRET_KEY="your_test_secret_key_here"

# 주의사항:
# 1. .env 파일은 절대 버전 관리 시스템에 커밋하지 마세요!
# 2. API 키는 타인과 절대 공유하지 마세요
# 3. 정기적으로 키를 재발급하는 것을 권장합니다
# 4. 테스트용과 실제 거래용 키를 반드시 분리하세요
